<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Module 12 Problem 1"/>
        <attribute name="authors" value="Student"/>
        <attribute name="about" value="Assign 10 last names to an array and display them forward and in reverse."/>
        <attribute name="saved" value="2026-11-25 08:57:49 AM"/>
        <attribute name="created" value="U3R1ZGVudDsyMDI2LTExLTI1OzA4OjUyOjAwIEFNOzE="/>
        <attribute name="edited" value="U3R1ZGVudDsyMDI2LTExLTI1OzA4OjUyOjAwIEFNOzE="/>
        <attribute name="edited" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTEtMjU7MDg6NTc6NDkgQU07MTszMDQw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastNames" type="String" array="True" size="10"/>
            <assign variable="lastNames[0]" expression="&quot;Smith&quot;"/>
            <assign variable="lastNames[1]" expression="&quot;Johnson&quot;"/>
            <assign variable="lastNames[2]" expression="&quot;Williams&quot;"/>
            <assign variable="lastNames[3]" expression="&quot;Brown&quot;"/>
            <assign variable="lastNames[4]" expression="&quot;Jones&quot;"/>
            <assign variable="lastNames[5]" expression="&quot;Garcia&quot;"/>
            <assign variable="lastNames[6]" expression="&quot;Miller&quot;"/>
            <assign variable="lastNames[7]" expression="&quot;Davis&quot;"/>
            <assign variable="lastNames[8]" expression="&quot;Rodriguez&quot;"/>
            <assign variable="lastNames[9]" expression="&quot;Martinez&quot;"/>
            <call expression="displayNames(lastNames)"/>
            <call expression="displayNamesReverse(lastNames)"/>
        </body>
    </function>
    <function name="displayNames" type="None" variable="">
        <parameters>
            <parameter name="names" type="String" array="True"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Last Names (Forward Order):&quot;" newline="True"/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <output expression="names[i]" newline="True"/>
            </for>
        </body>
    </function>
    <function name="displayNamesReverse" type="None" variable="">
        <parameters>
            <parameter name="names" type="String" array="True"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Last Names (Reverse Order):&quot;" newline="True"/>
            <for variable="i" start="9" end="0" direction="dec" step="1">
                <output expression="names[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
